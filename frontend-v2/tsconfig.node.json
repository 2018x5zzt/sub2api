{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "strict": true,
    "emitDeclarationOnly": true,
    "outDir": "dist-tsbuild-node",
    "tsBuildInfoFile": "./node_modules/.cache/tsbuildinfo-node"
  },
  "include": ["vite.config.ts"]
}
